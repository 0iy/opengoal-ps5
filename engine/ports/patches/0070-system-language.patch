+    case 6: return SCE_DUTCH_LANGUAGE;
+    case 7: case 17: return SCE_PORTUGUESE_LANGUAGE;  // Portuguese, Portuguese (Brazil)
+    case 9: return SCE_KOREAN_LANGUAGE;
+    default: return SCE_ENGLISH_LANGUAGE;
+  }
