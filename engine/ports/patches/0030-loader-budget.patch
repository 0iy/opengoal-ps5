@@ -4,7 +4,16 @@
 
 #include "common/global_profiler/GlobalProfiler.h"
 
+// __ps5__ load-budget: the PS5 driver is CPU bound near 16 ms per frame, so 4.5 ms of uploads per frame shows
+// as stutter while levels stream in (driving fast in the city); load slower but smoother.
+#ifdef __ps5__
+// __ps5__ load-budget: slow and smooth while a level streams in ahead of time; full speed (more than upstream) once the
+// renderer asks for a level that is not loaded yet (a door opened: missing geometry is worse than one long frame)
+extern bool ps5_loader_urgent();
+#define LOAD_BUDGET (ps5_loader_urgent() ? 8.0f : 2.0f)
+#else
 constexpr float LOAD_BUDGET = 4.5f;
+#endif
 
