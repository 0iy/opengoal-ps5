+// __ps5__ merc-instancing
+void Merc2::init_instancing(ShaderLibrary& shaders) {
+#ifdef __ps5__
+  Shader& sh = shaders[ShaderId::MERC2_INST];
+  if (!sh.okay()) {
+    return;
+  }
+  init_shader_common(sh, &m_inst_uniforms, false);
+  const GLuint id = (GLuint)sh.id();
+  m_inst_base_loc = glGetUniformLocation(id, "inst_base");
+  glUniform1i(glGetUniformLocation(id, "bones_tbo"), 13);
+  glUniform1i(glGetUniformLocation(id, "inst_tbo"), 14);
+  glUniform1i(glGetUniformLocation(id, "lights_tbo"), 15);
+  glGenBuffers(1, &m_inst_buf);
+  glGenBuffers(1, &m_lights_buf);
+  glGenTextures(1, &m_bones_tbo);
+  glGenTextures(1, &m_inst_tbo);
+  glGenTextures(1, &m_lights_tbo);
+  m_inst_ok = m_inst_base_loc >= 0;
+#else
+  (void)shaders;
+#endif
+}
+
+// config/noinstance.txt is polled (about every 10 frames) so instancing can be switched while the game runs
+bool Merc2::inst_active() {
+#ifdef __ps5__
+  if (!m_inst_ok) {
+    return false;
+  }
+  if ((m_inst_poll++ & 63) == 0) {
+    struct stat st;
+    m_inst_on = stat("/data/opengoal/config/noinstance.txt", &st) != 0;
+  }
+  return m_inst_on;
+#else
+  return false;
+#endif
+}
+
+void Merc2::switch_to_inst(SharedRenderState* render_state) {
+  render_state->shaders[ShaderId::MERC2_INST].activate();
+  glUniform4f(m_inst_uniforms.fog_color, render_state->fog_color[0] / 255.f,
+              render_state->fog_color[1] / 255.f, render_state->fog_color[2] / 255.f,
+              render_state->fog_intensity / 255);
+  glUniform1i(m_inst_uniforms.gfx_hack_no_tex, Gfx::g_global_settings.hack_no_tex);
+}
+
+/*!
+ * Orders the draws of one bucket into runs. A run is one instanced draw. Opaque draws with equal geometry and material
+ * (from different models, so with different bones and lights) move together; blended draws and draws without depth
+ * write keep their order and only merge with an equal neighbour. Draws with modified vertices or the two-pass fade
+ * lighting stay on the old path. Returns false when instancing is off.
+ */
+bool Merc2::build_inst_plan(const Draw* da, u32 n) {
+  if (!m_inst_ok || n == 0) {
+    return false;
+  }
+  m_plan.clear();
+  m_runs.clear();
+  m_seg.clear();
+  auto key = [&](const Draw& d) {
+    u64 h = d.first_index;
+    h = h * 0x9E3779B97F4A7C15ull ^ d.index_count;
+    h = h * 0x9E3779B97F4A7C15ull ^ (u32)d.texture;
+    h = h * 0x9E3779B97F4A7C15ull ^ d.mode.as_int();
+    h = h * 0x9E3779B97F4A7C15ull ^ (d.flags | (u32)d.no_strip << 8);
+    h = h * 0x9E3779B97F4A7C15ull ^ d.hash;
+    return h;
+  };
+  auto same = [&](const Draw& a, const Draw& b) {
+    return a.first_index == b.first_index && a.index_count == b.index_count && a.texture == b.texture &&
+           a.mode.as_int() == b.mode.as_int() && a.flags == b.flags && a.no_strip == b.no_strip &&
+           a.hash == b.hash;
+  };
+  auto add_run = [&](u32 di, bool inst, bool ordered) {
+    m_runs.push_back({(u32)m_plan.size(), 1, inst, ordered});
+    m_plan.push_back(di);
+  };
+  auto flush_seg = [&]() {
+    if (m_seg.empty()) {
+      return;
+    }
+    m_open.clear();
+    u32 ngroups = 0;
+    for (u32 di : m_seg) {
+      const u64 k = key(da[di]);
+      bool placed = false;
+      auto it = m_open.find(k);
+      if (it != m_open.end()) {
+        auto& v = m_groups[it->second];
+        if (same(da[v[0]], da[di])) {
+          bool dup = false;  // one instance per skeleton: a model's own draws keep their order
+          for (u32 m : v) {
+            if (da[m].first_bone == da[di].first_bone) {
+              dup = true;
+              break;
+            }
+          }
+          if (!dup) {
+            v.push_back(di);
+            placed = true;
+          }
+        }
+      }
+      if (!placed) {
+        if (ngroups == m_groups.size()) {
+          m_groups.emplace_back();
+        }
+        m_groups[ngroups].clear();
+        m_groups[ngroups].push_back(di);
+        m_open[k] = ngroups++;
+      }
+    }
+    for (u32 g = 0; g < ngroups; g++) {
+      m_runs.push_back({(u32)m_plan.size(), (u32)m_groups[g].size(), true, false});
+      m_plan.insert(m_plan.end(), m_groups[g].begin(), m_groups[g].end());
+    }
+    m_seg.clear();
+  };
+  for (u32 i = 0; i < n; i++) {
+    const Draw& x = da[i];
+    if ((x.flags & MOD_VTX) || m_lights_buffer[x.light_idx].w1) {
+      flush_seg();
+      add_run(i, false, true);
+    } else if (x.mode.get_ab_enable() || !x.mode.get_depth_write_enable()) {
+      flush_seg();
+      if (!m_runs.empty()) {
+        auto& r = m_runs.back();
+        if (r.inst && r.ordered && r.start + r.len == m_plan.size() && same(da[m_plan[r.start]], x)) {
+          r.len++;
+          m_plan.push_back(i);
+          continue;
+        }
+      }
+      add_run(i, true, true);
+    } else {
+      m_seg.push_back(i);
+    }
+  }
+  flush_seg();
+
+  {
+    static u64 st_calls = 0, st_draws = 0, st_runs = 0, st_inst = 0, st_old = 0;
+    st_calls++;
+    st_draws += n;
+    st_runs += m_runs.size();
+    for (const auto& r : m_runs) {
+      (r.inst ? st_inst : st_old) += 1;
+    }
+    if (st_calls == 600) {
+      ps5_log("merc-inst: per 600 flushes draws=%llu runs=%llu (instanced runs %llu, old-path draws %llu)",
+              (unsigned long long)st_draws, (unsigned long long)st_runs, (unsigned long long)st_inst,
+              (unsigned long long)st_old);
+      st_calls = st_draws = st_runs = st_inst = st_old = 0;
+    }
+  }
+  m_inst_data.resize(m_plan.size() * 2);
+  for (size_t k = 0; k < m_plan.size(); k++) {
+    m_inst_data[k * 2] = da[m_plan[k]].first_bone;
+    m_inst_data[k * 2 + 1] = da[m_plan[k]].light_idx;
+  }
+  m_light_pack.resize((size_t)m_next_free_light * 28);
+  for (u32 l = 0; l < m_next_free_light; l++) {
+    const auto& L = m_lights_buffer[l];
+    float* o = &m_light_pack[(size_t)l * 28];
+    const float v[28] = {L.direction0.x(), L.direction0.y(), L.direction0.z(), 1.f,
+                         L.direction1.x(), L.direction1.y(), L.direction1.z(), 0.f,
+                         L.direction2.x(), L.direction2.y(), L.direction2.z(), 0.f,
+                         L.color0.x(), L.color0.y(), L.color0.z(), L.color0.w(),
+                         L.color1.x(), L.color1.y(), L.color1.z(), L.color1.w(),
+                         L.color2.x(), L.color2.y(), L.color2.z(), L.color2.w(),
+                         L.ambient.x(), L.ambient.y(), L.ambient.z(), L.ambient.w()};
+    memcpy(o, v, sizeof(v));
+  }
+  glBindBuffer(GL_UNIFORM_BUFFER, m_inst_buf);
+  glBufferData(GL_UNIFORM_BUFFER, m_inst_data.size() * 4, m_inst_data.data(), GL_STREAM_DRAW);
+  glBindBuffer(GL_UNIFORM_BUFFER, m_lights_buf);
+  glBufferData(GL_UNIFORM_BUFFER, std::max<size_t>(m_light_pack.size() * 4, 16), m_light_pack.data(),
+               GL_STREAM_DRAW);
+  glBindBuffer(GL_UNIFORM_BUFFER, 0);
+  // texture buffers resolve the buffer storage when attached: attach again after every upload
+  glActiveTexture(GL_TEXTURE0 + 13);
+  glBindTexture(GL_TEXTURE_BUFFER, m_bones_tbo);
+  glTexBuffer(GL_TEXTURE_BUFFER, GL_RGBA32F, m_bones_buffer);
+  glActiveTexture(GL_TEXTURE0 + 14);
+  glBindTexture(GL_TEXTURE_BUFFER, m_inst_tbo);
+  glTexBuffer(GL_TEXTURE_BUFFER, GL_RG32UI, m_inst_buf);
+  glActiveTexture(GL_TEXTURE0 + 15);
+  glBindTexture(GL_TEXTURE_BUFFER, m_lights_tbo);
+  glTexBuffer(GL_TEXTURE_BUFFER, GL_RGBA32F, m_lights_buf);
+  glActiveTexture(GL_TEXTURE0);
+  return true;
 }
 
