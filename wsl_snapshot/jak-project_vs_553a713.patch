+std::string get_current_executable_path() {
+#ifdef _WIN32
+  // NOTE - MAX_PATH is kinda wrong here as you can have a path longer than 260 in windows
+  wchar_t path[MAX_PATH];
+  GetModuleFileNameW(NULL, path, MAX_PATH);
