+    if (dt > gputrace_top[min_i].dt_ns) {
+        gputrace_top[min_i].dt_ns = dt;
+        gputrace_top[min_i].draw_index = draw_index;
+        gputrace_top[min_i].words = words;
+    }
+    pthread_mutex_unlock(&gputrace_lock);
